# ── Database (Neon) ─────────────────────────────────────────────
# Pooled URL (host contains "-pooler"), used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/siip?sslmode=require"
# Direct URL, used by Prisma migrations only.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/siip?sslmode=require"
# Max connections per serverless instance (keep small).
DATABASE_POOL_MAX=5

# ── App / Auth ──────────────────────────────────────────────────
APP_URL="http://localhost:3000"
# 32+ random chars: `openssl rand -base64 32`
BETTER_AUTH_SECRET=""
# Bump when the privacy notice changes; stored with each user's consent.
CONSENT_VERSION="2026-11-01"

# ── Email (Resend) ──────────────────────────────────────────────
# Leave empty in development to log emails instead of sending them.
RESEND_API_KEY=""
EMAIL_FROM="SIIP <no-reply@your-verified-domain.ng>"

# ── File storage (Cloudinary) ───────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Rate limiting (Upstash Redis) ───────────────────────────────
# Leave empty in development to disable rate limiting.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Cron ────────────────────────────────────────────────────────
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=""

# ── Seed ────────────────────────────────────────────────────────
SEED_SUPER_ADMIN_EMAIL="admin@siip.local"
SEED_SUPER_ADMIN_PASSWORD="ChangeMe!2026"
