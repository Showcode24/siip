{
  "name": "siip",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev:backend": "pnpm --filter @siip/backend dev",
    "dev:frontend": "pnpm --filter @siip/frontend dev",
    "db:local": "pnpm --filter @siip/backend db:local",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm --filter @siip/backend test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
