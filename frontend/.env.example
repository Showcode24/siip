# true = use the in-memory mock data in src/client/mocks (no backend needed)
NEXT_PUBLIC_USE_MOCKS=true
# Share of mock reads that fail on purpose, to exercise error states (0 to disable)
NEXT_PUBLIC_MOCK_ERROR_RATE=0.03
# Backend URL that /api/* is proxied to (used when NEXT_PUBLIC_USE_MOCKS=false)
API_URL=http://localhost:4000
